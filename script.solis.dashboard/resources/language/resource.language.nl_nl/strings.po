"Content-Type: text/plain; charset=UTF-8\n"
"Language: nl_NL\n"

msgctxt "#30000"
msgid "General"
msgstr "Algemeen"

msgctxt "#30001"
msgid "Dashboard address (IP or name of your Homey)"
msgstr "Adres van het dashboard (IP of naam van je Homey)"

msgctxt "#30002"
msgid "Dashboard port"
msgstr "Poort van het dashboard"

msgctxt "#30003"
msgid "Refresh every (seconds)"
msgstr "Verversen elke (seconden)"

msgctxt "#30004"
msgid "Switch page automatically every (seconds, 0 = off)"
msgstr "Automatisch van pagina wisselen elke (seconden, 0 = uit)"

msgctxt "#30005"
msgid "Start page"
msgstr "Startpagina"

msgctxt "#30010"
msgid "No connection to the dashboard. Check the address in the add-on settings."
msgstr "Geen verbinding met het dashboard. Controleer het adres bij de instellingen van de add-on."

msgctxt "#30011"
msgid "Use left and right to switch pages, Back to close"
msgstr "Links en rechts wisselen van pagina, Terug sluit af"

msgctxt "#30006"
msgid "Display"
msgstr "Weergave"

msgctxt "#30007"
msgid "Address of the computer running the image server"
msgstr "Adres van de computer met de beeldserver"

msgctxt "#30008"
msgid "Image server port"
msgstr "Poort van de beeldserver"

msgctxt "#30020"
msgid "Real dashboard as image (1 to 1)"
msgstr "Echt dashboard als beeld (1 op 1)"

msgctxt "#30021"
msgid "Built-in pages"
msgstr "Ingebouwde pagina's"

msgctxt "#30012"
msgid "No connection to the image server. Is it running on the computer?"
msgstr "Geen verbinding met de beeldbron. Controleer het Homey-adres in de instellingen (of draait de beeldserver?)."

msgctxt "#30022"
msgid "Image from the Homey app (recommended, no computer needed)"
msgstr "Beeld uit de Homey-app (aanbevolen, geen computer nodig)"

msgctxt "#30030"
msgid "Notifications"
msgstr "Meldingen"

msgctxt "#30031"
msgid "Notifications on the TV"
msgstr "Meldingen op de tv"

msgctxt "#30032"
msgid "Show each notification for (seconds)"
msgstr "Elke melding tonen (seconden)"

msgctxt "#30033"
msgid "Do not notify while a video is playing"
msgstr "Geen meldingen tijdens het afspelen van video"

msgctxt "#30034"
msgid "Only warnings and good moments"
msgstr "Alleen waarschuwingen en goede momenten"

msgctxt "#30040"
msgid "PIN (leave empty = ask every time)"
msgstr "PIN (leeg laten = elke keer vragen)"

msgctxt "#30041"
msgid "Appliances"
msgstr "Apparaten"

msgctxt "#30050"
msgid "TV extras"
msgstr "Extra's op de tv"

msgctxt "#30051"
msgid "Mini card: show for (seconds)"
msgstr "Mini-kaart: tonen (seconden)"

msgctxt "#30052"
msgid "Coloured edge around the screen (traffic light)"
msgstr "Kleurrand op het scherm (kan Kodi laten vastlopen, niet aanbevolen)"

msgctxt "#30053"
msgid "Large text"
msgstr "Grote letters"

msgctxt "#30054"
msgid "Red button goes to page"
msgstr "Rode knop gaat naar pagina"

msgctxt "#30055"
msgid "Green button goes to page"
msgstr "Groene knop gaat naar pagina"

msgctxt "#30056"
msgid "Yellow button goes to page"
msgstr "Gele knop gaat naar pagina"

msgctxt "#30057"
msgid "Blue button goes to page"
msgstr "Blauwe knop gaat naar pagina"

msgctxt "#30060"
msgid "Sun"
msgstr "Zon"

msgctxt "#30061"
msgid "Power"
msgstr "Stroom"

msgctxt "#30062"
msgid "Details"
msgstr "Details"

msgctxt "#30063"
msgid "Insight"
msgstr "Inzicht"

msgctxt "#30064"
msgid "Overview"
msgstr "Overzicht"

msgctxt "#30065"
msgid "Dynamic"
msgstr "Dynamisch"

msgctxt "#30066"
msgid "Usage"
msgstr "Verbruik"

msgctxt "#30067"
msgid "Smart"
msgstr "Slim"

msgctxt "#30068"
msgid "Options"
msgstr "Opties"

msgctxt "#30070"
msgid "OK = appliances   i = day   up/down = zoom   colour = page"
msgstr "OK = apparaten   i = dag   omhoog/omlaag = zoom   kleur = pagina"

msgctxt "#30080"
msgid "LED light of the box (traffic light)"
msgstr "Lampje van het kastje (verkeerslicht)"

msgctxt "#30081"
msgid "Use the LED as traffic light"
msgstr "Lampje gebruiken als verkeerslicht"

msgctxt "#30082"
msgid "Off"
msgstr "Uit"

msgctxt "#30083"
msgid "Three LEDs (red, green, yellow)"
msgstr "Drie lampjes (rood, groen, geel)"

msgctxt "#30084"
msgid "One RGB LED"
msgstr "Eén kleurenlampje (RGB)"

msgctxt "#30085"
msgid "One LED (steady = green, slow blink = orange, fast blink = red)"
msgstr "Eén lampje (vast = groen, rustig knipperen = oranje, snel knipperen = rood)"

msgctxt "#30086"
msgid "Name of the red LED"
msgstr "Naam van het rode lampje"

msgctxt "#30087"
msgid "Name of the green LED"
msgstr "Naam van het groene lampje"

msgctxt "#30088"
msgid "Name of the yellow LED"
msgstr "Naam van het gele lampje"

msgctxt "#30089"
msgid "Name of the red channel"
msgstr "Naam van het rode kanaal"

msgctxt "#30090"
msgid "Name of the green channel"
msgstr "Naam van het groene kanaal"

msgctxt "#30091"
msgid "Name of the blue channel"
msgstr "Naam van het blauwe kanaal"

msgctxt "#30092"
msgid "Name of the LED"
msgstr "Naam van het lampje"

msgctxt "#30093"
msgid "LED brightness (%)"
msgstr "Helderheid van het lampje (%)"

msgctxt "#30094"
msgid "Switch the LED off at night (23:00-07:00)"
msgstr "Lampje uit in de nacht (23:00-07:00)"

msgctxt "#30095"
msgid "Show which LEDs this box has"
msgstr "Laat zien welke lampjes dit kastje heeft"

msgctxt "#30096"
msgid "Experimental"
msgstr "Experimenteel"

msgctxt "#30097"
msgid "LEDs found"
msgstr "Gevonden lampjes"

msgctxt "#30098"
msgid "No LED found that Kodi can control. This works on CoreELEC boxes with a light; not on Fire TV or Android TV."
msgstr "Geen lampje gevonden dat Kodi kan bedienen. Dit werkt op CoreELEC-kastjes met een lampje; niet op Fire TV of Android TV."

msgctxt "#30099"
msgid "Light bar (white LEDs: green = all, orange = half, red = 3)"
msgstr "Lichtbalk (witte lampjes: groen = alle, oranje = de helft, rood = 3)"

msgctxt "#30100"
msgid "Light bar: start of the LED names (for example led)"
msgstr "Lichtbalk: begin van de lampnamen (bijvoorbeeld led)"
